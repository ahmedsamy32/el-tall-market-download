Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

# Force HTTPS on live domain
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(www\.)?eltal-market\.com$ [NC]
RewriteRule ^ https://eltal-market.com%{REQUEST_URI} [L,R=301]

# Remove .html extension from URL (Redirect .html to clean URLs)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^.]+)\.html [NC]
RewriteRule ^ %1 [R=301,L]

# Exclude market directory from root rewrites
RewriteRule ^market($|/) - [L]

# Clean HTML Routes
RewriteRule ^$ index.html [L]
RewriteRule ^download/?$ download.html [L]
RewriteRule ^about/?$ about.html [L]
RewriteRule ^privacy/?$ privacy.html [L]
RewriteRule ^terms/?$ terms.html [L]
RewriteRule ^admin/?$ admin.html [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
</IfModule>
