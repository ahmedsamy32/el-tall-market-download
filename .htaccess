Options -Indexes
DirectoryIndex index.html

<IfModule mod_rewrite.c>
RewriteEngine On

RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(www\.)?eltal-market\.com$ [NC]
RewriteRule ^ https://eltal-market.com%{REQUEST_URI} [L,R=301]

# Exclude market directory from root rewrites
RewriteRule ^market($|/) - [L]

# Clean Public HTML routes
RewriteRule ^$ index.html [L]
RewriteRule ^download/?$ download.html [L]
RewriteRule ^about/?$ about.html [L]
RewriteRule ^privacy/?$ privacy.html [L]
RewriteRule ^terms/?$ terms.html [L]
RewriteRule ^admin/?$ admin.html [L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
</IfModule>
